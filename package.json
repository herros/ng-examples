    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.5",
    "@angular/cli": "^22.0.5",
    "@angular/compiler-cli": "^22.0.6",
    "@faker-js/faker": "^10.5.0",
    "@testing-library/angular": "^19.4.1",
    "@testing-library/dom": "^10.4.1",
